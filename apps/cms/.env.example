# =============================================================================
# CORE GROUP CMS (apps/cms) — environment reference
#
# Public browser configuration only. Every VITE_* value is inlined into the
# built JavaScript bundle and is visible to anyone who loads the CMS.
# NEVER put a secret, API token, or database credential in a VITE_* var.
# All privileged work happens server-side behind the staff session.
# =============================================================================

# Origin of the shared CORE GROUP backend API.
#   local:   http://localhost:3000
#   staging: https://api-staging.corcotton.in
# The CMS calls only /api/v1/admin/* (and /api/v1/health) on this origin,
# with credentials. It never talks to MySQL, Cloudinary, Cashfree, or any
# carrier directly.
VITE_API_BASE_URL=http://localhost:3000

# Storefront origin — used only to build "Preview draft" deep links
# (CMS mints a short-lived preview token, then opens the storefront here
# with ?preview=<token>).
VITE_STOREFRONT_URL=http://localhost:5173
