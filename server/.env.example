# =============================================================================
# CORE GROUP backend (server) — environment reference
#
# Copy to server/.env and fill in. This file is committed; it must contain
# ONLY safe placeholders and comments — never a real secret value.
#
# Ownership legend:
#   [backend]  — used only by the Node backend. Never expose to any frontend.
#   [secret]   — sensitive. Never commit a real value; never put in a VITE_* var.
#   [restart]  — a change takes effect only after the backend process restarts.
# =============================================================================


# =============================================================================
# Application / Server
# =============================================================================

# development | test | production. Controls error verbosity, cookie Secure
# flags, the dev-only secret fallbacks, and disables the Mock shipping
# adapter in production. [backend] [restart]
NODE_ENV=development

# TCP port the API listens on (localhost-bound behind nginx on the VPS). [backend] [restart]
PORT=3000


# =============================================================================
# Database (MySQL 8.x)
# =============================================================================
# [backend] [secret: DB_PASSWORD] [restart]

DB_HOST=localhost
DB_PORT=3306
DB_NAME=cor_group
DB_USER=root
# Never commit a real value.
DB_PASSWORD=


# =============================================================================
# CORS / Origins
# =============================================================================

# Comma-separated list of browser origins allowed to call the API with
# credentials. Defaults to the three local dev ports (5173/5174/5175) when
# unset. Include every deployed frontend origin. Never wildcard. [backend] [restart]
CORS_ALLOWED_ORIGINS=

# Comma-separated origins allowed to call the privileged /api/v1/admin/*
# surface. Narrower than CORS_ALLOWED_ORIGINS (storefronts must not reach
# admin). Defaults to http://localhost:5175. [backend] [restart]
CMS_ALLOWED_ORIGINS=


# =============================================================================
# Trust Proxy
# =============================================================================

# Express `trust proxy` value. Leave unset for direct local dev. Behind
# nginx on the VPS (exactly one trusted hop) set TRUST_PROXY=1 so req.ip,
# the auth rate limiters, and audit logging see the real client IP.
# Accepts a hop count, a named preset, or a CIDR list — never the literal
# "true" (spoofable; rejected at boot). [backend] [restart]
TRUST_PROXY=


# =============================================================================
# Customer Auth — JWT access token
# =============================================================================
# [backend] [restart]

# HMAC signing secret for the short-lived customer access-token JWT.
# >= 32 chars. Required in production (dev generates an ephemeral one with
# a warning). Never commit a real value. [secret]
JWT_SECRET=
JWT_ISSUER=cor-group-backend
JWT_AUDIENCE=cor-group-client
# Access-token lifetime in seconds (default 900 = 15 min).
JWT_ACCESS_TTL_SECONDS=900


# =============================================================================
# Customer Auth — session (opaque rotating refresh token, httpOnly cookies)
# =============================================================================
# [backend] [restart]

SESSION_COOKIE_NAME=cor_group_session
REFRESH_COOKIE_NAME=cor_group_refresh
# Customer session policy, enforced server-side on every request and on refresh.
# A session ends after this many minutes without activity...
CUSTOMER_SESSION_IDLE_TIMEOUT_MINUTES=720
# ...or this many hours after login, whichever comes first. Refresh never extends it.
CUSTOMER_SESSION_MAX_LIFETIME_HOURS=168


# =============================================================================
# Customer Auth — OTP policy
# =============================================================================
# [backend] [restart]

# HMAC pepper for OTP hashes — never stored in the DB. >= 16 chars.
# Required in production. Never commit a real value. [secret]
OTP_PEPPER=
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# MOCK = OTP generated/verified for real but logged to the console instead
# of being delivered (dev/test only; refuses to run in production).
# REAL = deliver via the configured WhatsApp / SMTP providers.
OTP_PROVIDER_MODE=MOCK


# =============================================================================
# Staff Auth (CMS) — email + password, scrypt, DB-backed sessions
# =============================================================================
# [backend] [restart]

# HttpOnly staff session cookie name — distinct from the customer cookie.
STAFF_SESSION_COOKIE_NAME=cor_group_staff_session
# Absolute session lifetime (hours) and sliding idle timeout (minutes).
STAFF_SESSION_TTL_HOURS=12
STAFF_SESSION_IDLE_TIMEOUT_MINUTES=120
# Minimum staff password length (policy is stronger than consumer rules).
STAFF_PASSWORD_MIN_LENGTH=12

# Consumed once by `npm run staff:create` / `npm run staff:password` when
# there is no interactive TTY and no --password-stdin. Never echoed, never
# logged. Leave unset in normal use. [secret]
# STAFF_INITIAL_PASSWORD=


# =============================================================================
# Rate Limits
# =============================================================================
# [backend] [restart]

# Staff login brute-force protection — IP-keyed (needs a correct
# TRUST_PROXY behind nginx). Window in ms, max attempts per window.
STAFF_LOGIN_RATE_LIMIT_WINDOW_MS=300000
STAFF_LOGIN_RATE_LIMIT_MAX=10
# (Customer OTP endpoints have their own fixed in-code limiters.)


# =============================================================================
# Google Auth (Sign in with Google)
# =============================================================================

# Google Cloud OAuth client id the backend verifies GIS credentials
# against. This is a PUBLIC identifier (also set as VITE_GOOGLE_CLIENT_ID
# in the frontends) — not a secret, but must match. [backend]
GOOGLE_CLIENT_ID=


# =============================================================================
# WhatsApp OTP (Infyntra) — only used when OTP_PROVIDER_MODE=REAL
# =============================================================================
# [backend] [secret: INFYNTRA_API_KEY] [restart]

INFYNTRA_API_BASE_URL=
INFYNTRA_API_KEY=
INFYNTRA_PHONE_ID=
INFYNTRA_OTP_TEMPLATE=
INFYNTRA_OTP_TEMPLATE_LANGUAGE=

# Phone number shape required by the outbound provider (WhatsApp today;
# also the future carrier booking format). Internal canonical form is
# always +91XXXXXXXXXX; the provider adapter owns the conversion — no
# frontend ever formats a number for a provider.
#   10_DIGITS_NO_COUNTRY_CODE  ->  9876543210
#   91_PLUS_10_DIGITS          ->  919876543210
PROVIDER_PHONE_FORMAT=10_DIGITS_NO_COUNTRY_CODE


# =============================================================================
# Email (SMTP) — transactional email / email OTP when OTP_PROVIDER_MODE=REAL
# =============================================================================
# [backend] [secret: SMTP_PASSWORD] [restart]

SMTP_HOST=
SMTP_PORT=
# true / false
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_FROM=


# =============================================================================
# Media (abstraction) + Cloudinary provider
# =============================================================================
# [backend] — the CMS and storefront NEVER call Cloudinary directly; all
# media operations go CMS/storefront -> Admin/Media API -> Media Service ->
# provider adapter -> Cloudinary. Never prefix any of these with VITE_.

# Active media provider resolved by server/src/platform/media. Currently
# only "cloudinary".
MEDIA_PROVIDER=cloudinary

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
# Never commit a real value. [secret]
CLOUDINARY_API_SECRET=


# =============================================================================
# Payments (Cashfree)
# =============================================================================
# [backend] — provider enablement/priority lives in MySQL. The storefront
# only ever receives a hosted-checkout URL/session; it never holds these.

# SANDBOX | PRODUCTION
CASHFREE_ENVIRONMENT=SANDBOX
CASHFREE_API_BASE_URL=
# YYYY-MM-DD API version pin.
CASHFREE_API_VERSION=2025-01-01
CASHFREE_CLIENT_ID=
# Never commit a real value. [secret]
CASHFREE_CLIENT_SECRET=
# Where Cashfree returns the customer after hosted checkout.
PAYMENT_RETURN_BASE_URL=http://localhost:5173
# How long a payment-reserved inventory hold lasts (seconds).
PAYMENT_RESERVATION_TTL_SECONDS=1800


# =============================================================================
# Shipping / Logistics
# =============================================================================
# [backend] [restart] — the CMS and storefront NEVER call a carrier
# directly. Path: Storefront/CMS -> Shipping API -> ShippingService ->
# LogisticsOrchestrator -> Provider Registry -> carrier adapter.

# MOCK | REAL.
#   MOCK  — the development Mock adapter (auto-disabled when NODE_ENV=production).
#   REAL  — selects the real carrier adapter(s) via the Provider Registry.
#           Which carrier is actually used is decided by the
#           `shipping_providers` / `shipping_provider_services` /
#           `shipping_provider_zones` tables in MySQL, NOT by this value.
# When REAL, the required carrier credentials below MUST be present or the
# backend refuses to start (no silent fallback to MOCK).
SHIPPING_PROVIDER_MODE=MOCK

# Per-provider quote timeout in ms.
SHIPPING_PROVIDER_TIMEOUT_MS=5000
# Dispatch origin PIN (6 digits) sent to carriers for serviceability.
SHIPPING_ORIGIN_POSTAL_CODE=
# Flat shipping charge in paise used by the Mock adapter (0 = free).
SHIPPING_STANDARD_CHARGE_MINOR=0

# Owner Delivery — the ops mailbox emailed when a customer places an
# Owner-Delivery order (the store delivers it themselves). Zones + the master
# on/off toggle are configured in the CMS (Providers -> Shipping pricing).
# Defaults to orders@corcotton.in when unset. [backend]
OWNER_DELIVERY_NOTIFY_EMAIL=

# India Post PIN-code lookup (address forms). Source: Department of Posts
# "All India Pincode Directory" on data.gov.in. Register free at
# https://data.gov.in and generate an API key. Without a key, stored directory
# rows still answer and every other PIN is reported as unverifiable — the
# address form stays fully manual, nothing is blocked. After setting the key,
# run `npm run postal:sync` (monthly) to load the whole directory. [backend]
DATA_GOV_IN_API_KEY=
# The directory's resource id on data.gov.in (default shown).
POSTAL_DIRECTORY_RESOURCE_ID=5c2f62fe-5afa-4119-a499-fec9d604d5bd
# Timeout for one live lookup in ms (max 15000).
POSTAL_LOOKUP_TIMEOUT_MS=4000


# =============================================================================
# Storefront + marketing automation
# =============================================================================
# Customer-facing storefront origin — used to build links in customer emails
# (e.g. the "return to your cart" link in an abandoned-cart reminder). No
# trailing slash. [backend]
STOREFRONT_BASE_URL=http://localhost:5173

# Abandoned-cart recovery scanner. Per-campaign on/off lives in the CMS
# (Marketing -> Abandoned Carts); this only turns the whole worker on/off.
# A tick with no ACTIVE campaign is a cheap no-op. Run `npm run seed:abandoned-cart`
# once per environment to install the default templates + a PAUSED campaign. [backend] [restart]
ABANDONED_CART_WORKER_ENABLED=true
ABANDONED_CART_INTERVAL_MS=900000
ABANDONED_CART_BATCH_SIZE=50

# Instagram (homepage "Real People. Real Style." section, official Instagram
# API). An admin connects the account once in CMS -> Providers -> Instagram by
# pasting a long-lived access token; it is stored ENCRYPTED with this key and
# renewed automatically before its 60 days run out. Unset => an account cannot
# be connected (fails closed). 32 bytes as 64 hex chars or base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing or changing the key makes the stored token unreadable: reconnect the
# account in the CMS. [backend] [restart] [secret]
PROVIDER_SECRET_ENCRYPTION_KEY=
# Renews the token when due and pulls the latest posts (and their pictures).
INSTAGRAM_WORKER_ENABLED=true
INSTAGRAM_SYNC_INTERVAL_MS=1800000
# Re-derives provider health from recorded attempts (no provider is called) and
# puts a change that needs attention in the CMS bell: a provider becoming
# unavailable, failing often or rejecting its credentials, and recovering.
# [backend] [restart]
PROVIDER_HEALTH_WORKER_ENABLED=true
PROVIDER_HEALTH_INTERVAL_MS=300000


# =============================================================================
# Delhivery (carrier adapter)
# =============================================================================
# [backend] [secret: DELHIVERY_API_TOKEN] [restart] — NEVER expose to the
# CMS or storefront; NEVER prefix with VITE_; NEVER commit the real token.
#
# Current adapter scope: the FULL surface — serviceability, TAT, rate quote,
# manifest/book, edit, cancel, pickup request, label, tracking, NDR and
# warehouse registration. Booking runs through the MOCK adapter only while
# SHIPPING_PROVIDER_MODE=MOCK; with MODE=REAL these calls reach the carrier
# and create real freight.

# Environment-specific Delhivery API base URL, e.g. the account's staging
# vs production express endpoint. Used verbatim by the adapter.
#
# CAUTION: track.delhivery.com is the LIVE account. Pointing a local machine
# at it and booking a shipment manifests a real parcel and schedules a real
# pickup — this has happened (AWB 54729910000151). Use the UAT host for
# anything that is not production.
DELHIVERY_API_BASE_URL=

# Delhivery API token. Sent as `Authorization: Token <value>`. [secret]
DELHIVERY_API_TOKEN=

# Escape hatch for the live-write guard. The adapter refuses every mutating
# call (book / edit / cancel / pickup / warehouse create+edit) when NODE_ENV
# is not `production` and the base URL is a live Delhivery host. Reads are
# always allowed. Set this to `true` ONLY to book real freight deliberately
# from a non-production process; leave it unset everywhere else. Deployed
# stacks run NODE_ENV=production, so they are unaffected either way.
# DELHIVERY_ALLOW_LIVE_WRITES=false

# Optional: PINs used by `npm run verify:delhivery`'s real-serviceability
# check on an environment where the credentials are present. Not secrets.
# DELHIVERY_TEST_SERVICEABLE_PIN=110001
# DELHIVERY_TEST_INVALID_PIN=999999

# Shared secret Delhivery sends back on every inbound Scan Push webhook call
# (header configurable via DELHIVERY_WEBHOOK_TOKEN_HEADER, default
# `x-delhivery-webhook-token`). Give Delhivery this exact value as "the
# header value" when they enable webhooks (WP-01 / provider request-pack §9)
# — distinct from DELHIVERY_API_TOKEN above, which is our OUTBOUND credential
# for calling Delhivery, not theirs for calling us. [secret]
DELHIVERY_WEBHOOK_TOKEN=
# DELHIVERY_WEBHOOK_TOKEN_HEADER=x-delhivery-webhook-token


# =============================================================================
# Inventory reservation expiry worker
# =============================================================================
# [backend] [restart]

INVENTORY_RESERVATION_TTL_SECONDS=900
# true / false
INVENTORY_RESERVATION_EXPIRY_WORKER_ENABLED=true
INVENTORY_RESERVATION_EXPIRY_INTERVAL_MS=30000
INVENTORY_RESERVATION_EXPIRY_BATCH_SIZE=100


# =============================================================================
# Order finalization worker
# =============================================================================
# [backend] [restart]

# true / false
ORDER_FINALIZATION_WORKER_ENABLED=true
ORDER_FINALIZATION_INTERVAL_MS=15000
ORDER_FINALIZATION_BATCH_SIZE=20


# =============================================================================
# Fulfillment recovery worker (Wave 7A.1)
# =============================================================================
# [backend] [restart] — safety net that re-creates a missing initial
# Fulfillment for a committed Order. Never books a carrier, never touches
# inventory.

# true / false
FULFILLMENT_RECOVERY_WORKER_ENABLED=true
FULFILLMENT_RECOVERY_INTERVAL_MS=60000
FULFILLMENT_RECOVERY_BATCH_SIZE=50

# Shipment automation (package -> book -> AWB -> label -> pickup).
# Business rule (2026-09-04): automation stops at warehouse allocation. The
# warehouse manager does every step after that manually. Leave these OFF.
# Set to true / AUTO only for a future phase that reintroduces auto-drive.
SHIPMENT_AUTOMATION_ENABLED=false
SHIPMENT_AUTOMATION_MODE=MANUAL


# =============================================================================
# Document artifact storage (Wave 8C-5)
# =============================================================================
# [backend] [restart] — private storage for rendered invoice / packing-slip /
# label PDFs. The LOCAL driver writes under a server-owned directory that is
# NEVER statically served; documents reach clients only through authenticated
# backend endpoints. No secret. A future R2/S3 driver plugs into
# DocumentStorageProvider without touching domain code.

DOCUMENT_STORAGE_DRIVER=LOCAL
# Relative to the server working directory; gitignored.
DOCUMENT_STORAGE_LOCAL_PATH=./.private-storage/documents
