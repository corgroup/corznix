{
  "name": "corznix",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Corznix platform monorepo (storefront, CMS, backend) — independent of Corcotton",
  "engines": {
    "node": ">=18.18.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "server"
  ],
  "scripts": {
    "dev:storefront": "npm run dev --workspace=apps/corznix",
    "dev:cms": "npm run dev --workspace=apps/cms",
    "dev:server": "npm run dev --workspace=server",
    "build:storefront": "npm run build --workspace=apps/corznix",
    "build:cms": "npm run build --workspace=apps/cms",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "migrate": "npm run migrate --workspace=server",
    "seed": "npm run seed --workspace=server"
  }
}
